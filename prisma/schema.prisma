// ============================================================
// SCHEMA PRISMA — GESTIONADOR DE RECURSOS  (v2.0)
// ============================================================
// Decisiones de diseño:
//   - Modelos en PascalCase (requerido por Prisma) con @@map
//     apuntando a las tablas en snake_case de PostgreSQL.
//   - Campos en snake_case sin @map (sin transformación).
//   - Enums para todos los campos con valores fijos.
//   - UUIDs con @default(uuid()) → genera gen_random_uuid()
//     en el SQL de migración.
//   - @updatedAt reemplaza el trigger fn_set_updated_at().
//
// ⚠  ELEMENTOS QUE REQUIEREN RAW SQL POST-MIGRACIÓN:
//   1. Índices únicos parciales en categorias_transaccion y
//      categorias_inventario (WHERE empresa_id IS/IS NOT NULL)
//   2. Índice GIN en flujos_webhook.trigger_keys
//   3. CHECK constraint en transacciones (fecha_vencimiento)
//   4. Trigger fn_sync_chat_stats() para chats.no_leidos
//      y ultimo_mensaje
//   → Ver base de datos v2.sql para el SQL completo de cada uno.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Rol {
  admin    // Superusuario de plataforma — sin empresa
  gerente  // Admin de empresa — acceso total dentro de su empresa
  contador // Rol financiero — transacciones, cuentas, conciliación
  empleado // Rol operativo — inventario, kardex, producción, ventas
}

enum TipoTransaccion {
  income
  expense
}

enum EstadoTransaccion {
  completed
  pending
  overdue
}

enum TipoItem {
  product
  insumo
}

enum TipoMovimientoKardex {
  entrada
  salida
  ajuste
  produccion_entrada
  produccion_salida
}

enum ReferenciaTipo {
  produccion_log
  transaccion
  ajuste_manual
  importacion
}

enum CanalContacto {
  whatsapp
  messenger
  telegram
  otro
}

enum EstadoChat {
  open
  resolved
  pending
}

enum RemitenteChat {
  user
  bot
  agent
}

// ============================================================
// 1. MONEDAS
//    Catálogo ISO 4217. PK natural: código de 3 letras.
// ============================================================
model Moneda {
  codigo  String @id @db.Char(3)
  nombre  String @db.VarChar(100)
  simbolo String @db.VarChar(5)

  // Relaciones inversas
  empresas          Empresa[]
  cuentas_bancarias CuentaBancaria[]

  @@map("monedas")
}

// ============================================================
// 2. EMPRESA
//    Raíz del sistema. moneda_codigo es fuente canónica.
// ============================================================
model Empresa {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String   @default("MicroEmpresa S.A.") @db.VarChar(255)
  moneda_codigo String   @default("USD") @db.Char(3)
  logo_url      String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  // Relaciones
  moneda                 Moneda                 @relation(fields: [moneda_codigo], references: [codigo], onUpdate: Cascade)
  usuarios               Usuario[]
  categorias_transaccion CategoriaTransaccion[]
  transacciones          Transaccion[]
  categorias_inventario  CategoriaInventario[]
  inventario             InventarioItem[]
  produccion_log         ProduccionLog[]
  kardex                 Kardex[]
  flujos_webhook         FlujoWebhook[]
  contactos              Contacto[]
  chats                  Chat[]
  cuentas_bancarias      CuentaBancaria[]
  extractos_bancarios    ExtractoBancario[]
  configuracion          Configuracion[]

  @@map("empresa")
}

// ============================================================
// 3. USUARIOS
// ============================================================
model Usuario {
  id            String   @id @default(uuid()) @db.Uuid
  empresa_id    String?  @db.Uuid  // NULL solo para rol=admin (plataforma)
  nombre        String   @db.VarChar(255)
  email         String   @unique @db.VarChar(255)
  password_hash String
  avatar_url    String?
  rol                      Rol       @default(empleado)
  activo                   Boolean   @default(true)
  refresh_token_hash       String?   // bcrypt hash del refresh token activo
  refresh_token_expires_at DateTime? @db.Timestamptz(6)
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @updatedAt @db.Timestamptz(6)

  // Relaciones
  // empresa_id es nullable: admins de plataforma no pertenecen a empresa
  empresa        Empresa?        @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  transacciones  Transaccion[]
  produccion_log ProduccionLog[]
  kardex         Kardex[]

  @@index([empresa_id])
  @@map("usuarios")
}

// ============================================================
// 4. CATEGORIAS DE TRANSACCION
//    empresa_id nullable: NULL = global, UUID = privada.
//    ⚠ Los índices únicos parciales deben crearse via raw SQL.
// ============================================================
model CategoriaTransaccion {
  id         Int             @id @default(autoincrement())
  empresa_id String?         @db.Uuid
  nombre     String          @db.VarChar(100)
  tipo       TipoTransaccion

  // Relaciones
  empresa       Empresa?      @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  transacciones Transaccion[]

  @@index([empresa_id])
  @@map("categorias_transaccion")
}

// ============================================================
// 5. TRANSACCIONES
//    ⚠ CHECK (estado='completed' OR fecha_vencimiento IS NOT NULL)
//      debe crearse via raw SQL. Validar también en el servicio.
// ============================================================
model Transaccion {
  id                String            @id @default(uuid()) @db.Uuid
  empresa_id        String            @db.Uuid
  usuario_id        String?           @db.Uuid
  fecha             DateTime          @default(now()) @db.Date
  descripcion       String
  monto             Decimal           @db.Decimal(15, 2)
  tipo              TipoTransaccion
  categoria_id      Int
  estado            EstadoTransaccion @default(completed)
  fecha_vencimiento DateTime?         @db.Date
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @updatedAt @db.Timestamptz(6)

  // Relaciones
  empresa             Empresa              @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  usuario             Usuario?             @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  categoria           CategoriaTransaccion @relation(fields: [categoria_id], references: [id])
  extractos_bancarios ExtractoBancario[]

  @@index([empresa_id])
  @@index([fecha])
  @@index([tipo])
  @@index([estado])
  @@index([categoria_id])
  @@index([usuario_id])
  @@map("transacciones")
}

// ============================================================
// 6. CATEGORIAS DE INVENTARIO
//    Misma lógica que CategoriaTransaccion.
//    ⚠ Índices únicos parciales via raw SQL.
// ============================================================
model CategoriaInventario {
  id         Int     @id @default(autoincrement())
  empresa_id String? @db.Uuid
  nombre     String  @db.VarChar(100)

  // Relaciones
  empresa    Empresa?         @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  inventario InventarioItem[]

  @@index([empresa_id])
  @@map("categorias_inventario")
}

// ============================================================
// 7. INVENTARIO
//    precio_costo + precio_venta separados para calcular margen.
// ============================================================
model InventarioItem {
  id           String   @id @default(uuid()) @db.Uuid
  empresa_id   String   @db.Uuid
  sku          String   @db.VarChar(50)
  nombre       String   @db.VarChar(255)
  stock        Decimal  @default(0) @db.Decimal(15, 3)
  min_warning  Decimal  @default(0) @db.Decimal(15, 3)
  precio_costo Decimal  @default(0) @db.Decimal(15, 2)
  precio_venta Decimal? @db.Decimal(15, 2)
  categoria_id Int?
  imagen_url   String?
  tipo_item    TipoItem
  activo       Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  // Relaciones
  empresa        Empresa              @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  categoria      CategoriaInventario? @relation(fields: [categoria_id], references: [id])
  receta         Receta?
  ingrediente_en RecetaIngrediente[]  @relation("InsumoEnReceta")
  produccion_log ProduccionLog[]
  kardex         Kardex[]

  @@unique([empresa_id, sku])
  @@index([empresa_id])
  @@index([sku])
  @@index([tipo_item])
  @@index([stock])
  @@index([categoria_id])
  @@map("inventario")
}

// ============================================================
// 8. RECETAS
//    Un producto tiene exactamente una receta (1-1).
// ============================================================
model Receta {
  id          Int     @id @default(autoincrement())
  producto_id String  @unique @db.Uuid
  nombre      String? @db.VarChar(255)
  notas       String?

  // Relaciones
  producto     InventarioItem    @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  ingredientes RecetaIngrediente[]

  @@map("recetas")
}

// ============================================================
// 9. RECETA INGREDIENTES
// ============================================================
model RecetaIngrediente {
  id        Int     @id @default(autoincrement())
  receta_id Int
  insumo_id String  @db.Uuid
  cantidad  Decimal @db.Decimal(15, 3)

  // Relaciones
  receta Receta         @relation(fields: [receta_id], references: [id], onDelete: Cascade)
  insumo InventarioItem @relation("InsumoEnReceta", fields: [insumo_id], references: [id], onDelete: Restrict)

  @@unique([receta_id, insumo_id])
  @@index([receta_id])
  @@index([insumo_id])
  @@map("receta_ingredientes")
}

// ============================================================
// 10. LOG DE PRODUCCION
//     Inmutable (sin updated_at). Solo created_at.
// ============================================================
model ProduccionLog {
  id          String   @id @default(uuid()) @db.Uuid
  empresa_id  String   @db.Uuid
  producto_id String   @db.Uuid
  usuario_id  String?  @db.Uuid
  cantidad    Decimal  @db.Decimal(15, 3)
  notas       String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relaciones
  empresa  Empresa        @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  producto InventarioItem @relation(fields: [producto_id], references: [id])
  usuario  Usuario?       @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([empresa_id])
  @@index([producto_id])
  @@index([created_at])
  @@map("produccion_log")
}

// ============================================================
// 11. KARDEX
//     cantidad puede ser negativa (salidas).
//     referencia_tipo identifica la tabla de referencia_id.
// ============================================================
model Kardex {
  id              String               @id @default(uuid()) @db.Uuid
  empresa_id      String               @db.Uuid
  item_id         String               @db.Uuid
  usuario_id      String?              @db.Uuid
  tipo_movimiento TipoMovimientoKardex
  cantidad        Decimal              @db.Decimal(15, 3)
  stock_anterior  Decimal              @db.Decimal(15, 3)
  stock_nuevo     Decimal              @db.Decimal(15, 3)
  referencia_id   String?
  referencia_tipo ReferenciaTipo?
  notas           String?
  created_at      DateTime             @default(now()) @db.Timestamptz(6)

  // Relaciones
  empresa Empresa        @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  item    InventarioItem @relation(fields: [item_id], references: [id])
  usuario Usuario?       @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@index([empresa_id])
  @@index([item_id])
  @@index([tipo_movimiento])
  @@index([created_at])
  @@map("kardex")
}

// ============================================================
// 12. FLUJOS WEBHOOK
//     id ahora es UUID (el front maneja el display 'f1','f2').
//     trigger_keys es String[] → text[] en PostgreSQL.
//     ⚠ El índice GIN debe crearse via raw SQL:
//       CREATE INDEX ... ON flujos_webhook USING GIN(trigger_keys);
// ============================================================
model FlujoWebhook {
  id           String   @id @default(uuid()) @db.Uuid
  empresa_id   String   @db.Uuid
  nombre       String   @db.VarChar(255)
  trigger_keys String[]
  activo       Boolean  @default(true)
  orden        Int      @default(0)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @updatedAt @db.Timestamptz(6)

  // Relaciones
  empresa    Empresa        @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  mensajes   FlujoMensaje[]
  opciones   FlujoOpcion[]  @relation("OpcionesDelFlujo")
  destino_de FlujoOpcion[]  @relation("FlujoDestino")

  @@index([empresa_id])
  @@map("flujos_webhook")
}

// ============================================================
// 13. MENSAJES DEL FLUJO
// ============================================================
model FlujoMensaje {
  id        Int    @id @default(autoincrement())
  flujo_id  String @db.Uuid
  contenido String
  orden     Int    @default(0)

  // Relaciones
  flujo FlujoWebhook @relation(fields: [flujo_id], references: [id], onDelete: Cascade)

  @@index([flujo_id])
  @@map("flujos_mensajes")
}

// ============================================================
// 14. OPCIONES DEL FLUJO
//     id ahora es UUID (el front maneja el display 'o1','o2').
//     siguiente_flujo con onDelete: Restrict — no se puede
//     borrar el flujo destino si hay opciones apuntando a él.
// ============================================================
model FlujoOpcion {
  id              String  @id @default(uuid()) @db.Uuid
  flujo_id        String  @db.Uuid
  trigger_key     String  @db.VarChar(20)
  etiqueta        String  @db.VarChar(255)
  siguiente_flujo String? @db.Uuid
  orden           Int     @default(0)

  // Relaciones (dos relaciones distintas al mismo modelo → nombres)
  flujo   FlujoWebhook  @relation("OpcionesDelFlujo", fields: [flujo_id], references: [id], onDelete: Cascade)
  destino FlujoWebhook? @relation("FlujoDestino", fields: [siguiente_flujo], references: [id], onDelete: Restrict)

  @@index([flujo_id])
  @@map("flujos_opciones")
}

// ============================================================
// 15. CONTACTOS
// ============================================================
model Contacto {
  id         String        @id @default(uuid()) @db.Uuid
  empresa_id String        @db.Uuid
  nombre     String        @db.VarChar(255)
  telefono   String?       @db.VarChar(30)
  email      String?       @db.VarChar(255)
  canal      CanalContacto @default(whatsapp)
  activo     Boolean       @default(true)
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  updated_at DateTime      @updatedAt @db.Timestamptz(6)

  // Relaciones
  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  chats   Chat[]

  @@index([empresa_id])
  @@index([telefono])
  @@index([canal])
  @@map("contactos")
}

// ============================================================
// 16. CHATS
//     no_leidos y ultimo_mensaje mantenidos por el trigger
//     fn_sync_chat_stats() → debe crearse via raw SQL.
//     NO actualizar estos campos manualmente desde el back.
// ============================================================
model Chat {
  id               String     @id @default(uuid()) @db.Uuid
  empresa_id       String     @db.Uuid
  contacto_id      String     @db.Uuid
  estado           EstadoChat @default(open)
  no_leidos        Int        @default(0)
  ultimo_mensaje   String?
  ultima_actividad DateTime   @default(now()) @db.Timestamptz(6)
  created_at       DateTime   @default(now()) @db.Timestamptz(6)

  // Relaciones
  empresa  Empresa       @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  contacto Contacto      @relation(fields: [contacto_id], references: [id], onDelete: Cascade)
  mensajes ChatMensaje[]

  @@index([empresa_id])
  @@index([contacto_id])
  @@index([estado])
  @@index([ultima_actividad(sort: Desc)])
  @@map("chats")
}

// ============================================================
// 17. MENSAJES DE CHAT
// ============================================================
model ChatMensaje {
  id         String        @id @default(uuid()) @db.Uuid
  chat_id    String        @db.Uuid
  contenido  String
  remitente  RemitenteChat
  leido      Boolean       @default(false)
  created_at DateTime      @default(now()) @db.Timestamptz(6)

  // Relaciones
  chat Chat @relation(fields: [chat_id], references: [id], onDelete: Cascade)

  @@index([chat_id])
  @@index([created_at])
  @@map("chat_mensajes")
}

// ============================================================
// 18. CUENTAS BANCARIAS
// ============================================================
model CuentaBancaria {
  id            String   @id @default(uuid()) @db.Uuid
  empresa_id    String   @db.Uuid
  nombre        String   @db.VarChar(255)
  banco         String?  @db.VarChar(255)
  numero_cuenta String?  @db.VarChar(50)
  moneda_codigo String   @default("USD") @db.Char(3)
  saldo_actual  Decimal  @default(0) @db.Decimal(15, 2)
  activo        Boolean  @default(true)
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  // Relaciones
  empresa             Empresa            @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  moneda              Moneda             @relation(fields: [moneda_codigo], references: [codigo], onUpdate: Cascade)
  extractos_bancarios ExtractoBancario[]

  @@index([empresa_id])
  @@map("cuentas_bancarias")
}

// ============================================================
// 19. EXTRACTOS BANCARIOS
//     monto puede ser negativo (débito bancario).
//     empresa_id desnormalizado para queries sin JOIN extra.
// ============================================================
model ExtractoBancario {
  id               String   @id @default(uuid()) @db.Uuid
  cuenta_id        String   @db.Uuid
  empresa_id       String   @db.Uuid
  fecha            DateTime @db.Date
  descripcion      String
  monto            Decimal  @db.Decimal(15, 2)
  referencia_banco String?  @db.VarChar(100)
  conciliado       Boolean  @default(false)
  transaccion_id   String?  @db.Uuid
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  // Relaciones
  cuenta      CuentaBancaria @relation(fields: [cuenta_id], references: [id], onDelete: Cascade)
  empresa     Empresa        @relation(fields: [empresa_id], references: [id], onDelete: Cascade)
  transaccion Transaccion?   @relation(fields: [transaccion_id], references: [id], onDelete: SetNull)

  @@index([cuenta_id])
  @@index([empresa_id])
  @@index([fecha])
  @@index([conciliado])
  @@map("extractos_bancarios")
}

// ============================================================
// 20. CONFIGURACION
//     Clave/valor por empresa. 'moneda_codigo' NO va aquí.
//     Usar empresa.moneda_codigo como fuente canónica.
// ============================================================
model Configuracion {
  id         Int      @id @default(autoincrement())
  empresa_id String   @db.Uuid
  clave      String   @db.VarChar(100)
  valor      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  // Relaciones
  empresa Empresa @relation(fields: [empresa_id], references: [id], onDelete: Cascade)

  @@unique([empresa_id, clave])
  @@index([empresa_id])
  @@map("configuracion")
}
